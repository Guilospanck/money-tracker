# Credentials for scraper.js (MinhasEconomias login).
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# Note: do NOT name these USERNAME/PASSWORD — zsh exports $USERNAME by default,
# and dotenv won't override an already-set env var, so .env would be ignored.
ME_EMAIL=your-minhaseconomias-email@example.com
ME_PASSWORD=your-password
# Earliest year the scraper pulls transactions from (optional, defaults to 2020).
ME_START_YEAR=2020

# Credentials for backup.js (daily S3 CSV upload).
# The IAM user backing these keys should only have s3:PutObject on the bucket
# prefix below — see README "Backups (S3)" for the minimal IAM policy.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-money-tracker-backups
AWS_S3_PREFIX=backups
